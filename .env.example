# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://postgres:root@localhost:5432/groficina

# Se o banco usa SSL (ex: Supabase, Neon, Railway, Render):
DATABASE_SSL=false

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Configurações de primeiro acesso ───────────────────────────────────────────────
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123