# ── Banco de Dados PostgreSQL ──────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/groficina

# Se o banco usa SSL (ex: Supabase, Neon, Railway, Render):
DATABASE_SSL=true

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Gemini (se usar IA) ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here